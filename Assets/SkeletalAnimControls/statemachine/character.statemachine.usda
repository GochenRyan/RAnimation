#usda 1.0
(
    customLayerData = {
        dictionary ranim = {
            string doc = "Controllable character: Locomotion {Stand, Crouch, Sprint, Turn, Airborne, Dead} || Action {Free, UpperBodyBusy, FullBodyBusy} || Weapon {Unarmed, Pistol}. Montages and graph inputs by name; model data in <Stem>.profile.json."
            int stateMachineVersion = 1
        }
    }
    defaultPrim = "StateMachine"
)

def Scope "StateMachine"
{
    custom string[] ranim:events = ["Action", "ToggleWeapon", "Die", "Notify"]
    custom string ranim:name = "character"
    custom rel ranim:root = </StateMachine/States/Root>

    def Scope "States"
