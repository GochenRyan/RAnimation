#usda 1.0
(
    customLayerData = {
        dictionary ranim = {
            int animGraphVersion = 1
            string doc = "Hybrid seam: Walking (GPU) blended with a CpuOnly-marked Idle/Punch blend. The marked branch is evaluated on the CPU and uploaded as slot 0; the GPU blends slot 0 with the Walking texture term."
        }
    }
    defaultPrim = "AnimGraph"
)

def Scope "AnimGraph"
{
    custom int ranim:outputNode = 6

    def Scope "Node_0"
    {
        custom int ranim:clipIndex = 9
        custom float2 ranim:editorPos = (60, 40)
        custom bool ranim:looping = 1
        custom float ranim:playRate = 1
        custom string ranim:type = "ClipPlayer"
    }

    def Scope "Node_1"
    {
        custom int ranim:clipIndex = 1
        custom float2 ranim:editorPos = (60, 260)
        custom bool ranim:looping = 1
        custom float ranim:playRate = 1
        custom string ranim:type = "ClipPlayer"
    }

    def Scope "Node_2"
    {
        custom int ranim:clipIndex = 5
        custom float2 ranim:editorPos = (60, 440)
        custom bool ranim:looping = 1
        custom float ranim:playRate = 1
        custom string ranim:type = "ClipPlayer"
    }

    def Scope "Node_3"
    {
        custom float2 ranim:editorPos = (380, 350)
        custom rel ranim:in:A = </AnimGraph/Node_1>
        custom rel ranim:in:B = </AnimGraph/Node_2>
        custom float ranim:param = 0.3
        custom string ranim:type = "TwoWayBlend"
    }

    def Scope "Node_4"
    {
        custom float2 ranim:editorPos = (660, 350)
        custom rel ranim:in:Source = </AnimGraph/Node_3>
        custom string ranim:type = "CpuOnly"
    }

    def Scope "Node_5"
    {
        custom float2 ranim:editorPos = (900, 180)
        custom rel ranim:in:A = </AnimGraph/Node_0>
        custom rel ranim:in:B = </AnimGraph/Node_4>
        custom float ranim:param = 0.5
        custom string ranim:type = "TwoWayBlend"
    }

    def Scope "Node_6"
    {
        custom float2 ranim:editorPos = (1200, 180)
        custom rel ranim:in:Result = </AnimGraph/Node_5>
        custom string ranim:type = "Root"
    }
}
