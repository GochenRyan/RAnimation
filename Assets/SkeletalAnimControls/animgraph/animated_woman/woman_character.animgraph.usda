#usda 1.0
(
    customLayerData = {
        dictionary ranim = {
            int animGraphVersion = 1
            string doc = "Resident character graph for animated_woman (regression model: one clip per ring, Jump2 / Jump / Running stand in for the jump phases). Same node names as ual_character so the shared state machine drives both."
        }
